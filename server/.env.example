# Copy to .env for local dev (node --env-file-if-exists=.env picks it up automatically —
# see package.json). In Railway, set these as service variables instead; don't commit .env.

# Postgres connection string. In Railway: add a Postgres plugin, then in this service's
# Variables tab reference it as ${{Postgres.DATABASE_URL}} (or paste the value directly).
DATABASE_URL=postgres://user:password@localhost:5432/cogitador

# Key used to sign session tokens. Any long random string — change it for real deployments.
JWT_SECRET=dev-secret-change-me

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=https://cogitador-consulta.netlify.app
# A "*.somehost" entry matches any subdomain — handy for Netlify's per-branch/PR deploy
# previews, which each get their own subdomain:
# CORS_ORIGIN=https://cogitador-consulta.netlify.app,*.netlify.app
# Leave unset in local dev (Vite's proxy makes this a same-origin request, so CORS doesn't
# apply). Required once the frontend is deployed on a different domain than this backend.
CORS_ORIGIN=

# Railway sets this automatically; only needed locally if you want a port other than 8787.
PORT=8787

# Anthropic API key, powers the chat widget (POST /api/chat — see src/routes/chat.js). Get
# one at https://console.anthropic.com/settings/keys. Leave unset to run everything else
# (auth, rosters, catalog) without the chat feature — /api/chat replies 503 instead of
# crashing the server.
ANTHROPIC_API_KEY=

# Powers "olvidé mi contraseña" (POST /api/auth/forgot-password, see src/lib/mailer.js) via
# Resend (https://resend.com — free tier, no domain verification needed to start: their
# onboarding@resend.dev sender works out of the box). Leave unset to run everything else
# normally — the reset link is just logged to the server console instead of emailed, which is
# fine for local dev.
RESEND_API_KEY=
# Optional "From" address/name for reset emails. Defaults to Resend's shared test sender.
# Once you verify your own domain in the Resend dashboard, point this at it, e.g.
# "Cogitador de Consulta <no-reply@tu-dominio.com>".
RESEND_FROM=

# Base URL of the deployed *frontend* (no trailing slash), used to build the link inside the
# password-reset email — e.g. https://cogitador-consulta.netlify.app. Only needed once the
# frontend is deployed on a different origin than this backend; same-origin setups (Vite's
# dev proxy, or this process serving dist/) fall back to the request's own origin.
FRONTEND_URL=
